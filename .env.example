GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# Fallback provider — used only if Gemini fails (including its own retries)
GROQ_API_KEY=
GROQ_FLASH_MODEL=openai/gpt-oss-20b
GROQ_PRO_MODEL=openai/gpt-oss-120b
CORS_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=30
REQUEST_MAX_RETRIES=3
# GEM-3: notes pastes longer than this (chars) use the Gemini/Groq pro tier
NOTES_PRO_TIER_CHAR_THRESHOLD=4000
